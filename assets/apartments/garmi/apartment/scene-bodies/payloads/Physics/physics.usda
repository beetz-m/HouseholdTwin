        def PhysicsRevoluteJoint "cabinet_door_4_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.6981317
            float drive:angular:physics:stiffness = 6.981317
            uniform token drive:angular:physics:type = "force"
            float newton:velocityLimit = 0
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </tn__scenebodies_nG/Geometry/world/kitchen_cabinet>
            custom rel physics:body1
            append rel physics:body1 = </tn__scenebodies_nG/Geometry/world/kitchen_cabinet/cabinet_door_4>
