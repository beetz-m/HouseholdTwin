#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tn__scenebodies_nG"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "tn__scenebodies_nG"
{
    over "Physics"
    {
        over "cabinet_door_4_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
