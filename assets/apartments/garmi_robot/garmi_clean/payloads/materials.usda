    def Material "Fabric"
    {
        asset inputs:ColorTexture = @../textures/fabric.jpg@
        float inputs:ior = 1.5
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/Fabric/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/Fabric/ColorTexture.outputs:rgb>
            prepend float inputs:ior.connect = </Materials/Fabric.inputs:ior>
            prepend float inputs:metallic.connect = </Materials/Fabric.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/Fabric.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/Fabric.inputs:roughness>
            token outputs:surface
        }

        def Shader "ColorTexture" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            float4 inputs:fallback = (0.3185468, 0.31854683, 0.3185468, 1)
            prepend asset inputs:file.connect = </Materials/Fabric.inputs:ColorTexture>
            token inputs:sourceColorSpace = "auto"
            prepend float2 inputs:st.connect = </Materials/Fabric/Primvar_st_float2.outputs:result>
            token inputs:wrapS = "repeat"
            prepend token inputs:wrapS.connect = </Materials/Fabric.inputs:wrapMode>
            token inputs:wrapT = "repeat"
            prepend token inputs:wrapT.connect = </Materials/Fabric.inputs:wrapMode>
            float3 outputs:rgb
        }

        def Shader "Primvar_st_float2" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }

