            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/Face/ColorTexture.outputs:rgb>
            prepend float inputs:ior.connect = </Materials/Face.inputs:ior>
            prepend float inputs:metallic.connect = </Materials/Face.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/Face.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/Face.inputs:roughness>
            token outputs:surface
        }

        def Shader "ColorTexture" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            float4 inputs:fallback = (0.3185468, 0.31854683, 0.3185468, 1)
            prepend asset inputs:file.connect = </Materials/Face.inputs:ColorTexture>
            token inputs:sourceColorSpace = "auto"
            prepend float2 inputs:st.connect = </Materials/Face/Primvar_st_float2.outputs:result>
            token inputs:wrapS = "repeat"
            prepend token inputs:wrapS.connect = </Materials/Face.inputs:wrapMode>
            token inputs:wrapT = "repeat"
            prepend token inputs:wrapT.connect = </Materials/Face.inputs:wrapMode>
            float3 outputs:rgb
        }

        def Shader "Primvar_st_float2" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }

    def Material "clearpath_dark_grey"
    {
        color3f inputs:diffuseColor = (0.03310476, 0.033104762, 0.03310476)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/clearpath_dark_grey/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/clearpath_dark_grey.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/clearpath_dark_grey.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/clearpath_dark_grey.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/clearpath_dark_grey.inputs:roughness>
            token outputs:surface
        }
    }
}

