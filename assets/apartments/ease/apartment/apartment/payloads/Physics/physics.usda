#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "apartment"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "apartment"
{
    over "Physics"
    {
        def PhysicsPrismaticJoint "cabinet2_door_out_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "NewtonMimicAPI", "PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 40
            float drive:linear:physics:maxForce = 1
            float drive:linear:physics:stiffness = 400
            uniform token drive:linear:physics:type = "force"
            float newton:mimicCoef1 = 0.01
            rel newton:mimicJoint = </apartment/Physics/cabinet2_door_left_joint>
            float newton:velocityLimit = 1.5708
            uniform token physics:axis = "X"
            custom rel physics:body0
            append rel physics:body0 = </apartment/Geometry/apartment_root/kitchen_root/side_A/cabinet2>
            custom rel physics:body1
            append rel physics:body1 = </apartment/Geometry/apartment_root/kitchen_root/side_A/cabinet2/cabinet2_door_out_fancy>
            point3f physics:localPos0 = (0.277, -0.19, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 0.9999997, -0.0007963267, 0)
            quatf physics:localRot1 = (0, 0, -1, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.02
            custom float urdf:limit:effort = 1
        }

