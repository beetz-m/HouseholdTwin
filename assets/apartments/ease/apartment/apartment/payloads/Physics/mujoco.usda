        def MjcActuator "wardrobe_door_left_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -6.981317043304443, -0.6981316804885864, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            uniform double[] mjc:gainPrm = [6.981317043304443, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            append rel mjc:target = </apartment/Physics/wardrobe_door_left_joint>
