    def Material "M_Metal_Brushed"
    {
        asset inputs:ColorTexture = @../textures/EnvSamplerTex.jpg@
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/M_Metal_Brushed/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/M_Metal_Brushed/ColorTexture.outputs:rgb>
            prepend float inputs:metallic.connect = </Materials/M_Metal_Brushed.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/M_Metal_Brushed.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/M_Metal_Brushed.inputs:roughness>
            token outputs:surface
        }

        def Shader "ColorTexture" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            float4 inputs:fallback = (0.99999994, 1, 0.9999999, 1)
            prepend asset inputs:file.connect = </Materials/M_Metal_Brushed.inputs:ColorTexture>
            token inputs:sourceColorSpace = "auto"
            prepend float2 inputs:st.connect = </Materials/M_Metal_Brushed/Primvar_st_float2.outputs:result>
            token inputs:wrapS = "repeat"
            prepend token inputs:wrapS.connect = </Materials/M_Metal_Brushed.inputs:wrapMode>
            token inputs:wrapT = "repeat"
            prepend token inputs:wrapT.connect = </Materials/M_Metal_Brushed.inputs:wrapMode>
            float3 outputs:rgb
        }

        def Shader "Primvar_st_float2" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }

