    def Xform "sofa" (
        prepend references = @./geometries.usd@</Geometries/sofa>
    )
    {
        over "sofa"
        {
            token subsetFamily:materialBind:familyType = "partition"

            over "GeomSubset_001" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/sofa/VisualMaterials/M_Fabric_Sofa_Inst>
            }

            over "GeomSubset_002" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/sofa/VisualMaterials/M_Basic_Black>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "M_Fabric_Sofa_Inst" (
